# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Your Neon connection string (Neon dashboard → Connection Details → "Pooled connection" or the default one)
DATABASE_URL=postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# A password of your own choosing that protects the admin moderation page.
# Make it long and random — it's the only thing standing between the public and your comment queue.
ADMIN_TOKEN=change-this-to-something-long-and-random
